# macOS overrides, loaded after config from Ghostty's Application Support path.
# Cmd keeps Ghostty's native copy, paste, window, and zoom bindings, so the
# Linux Ctrl bindings are released back to the shell, Neovim, and Herdr.

# Option acts as Alt for Herdr's alt+ bindings and readline word movement.
macos-option-as-alt = true

keybind = ctrl+v=unbind
keybind = ctrl+shift+key_v=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+plus=unbind
keybind = ctrl+minus=unbind
keybind = ctrl+zero=unbind

# Herdr owns tabs; Cmd+T would otherwise open a native Ghostty tab.
keybind = cmd+t=unbind
