# Font Configuration
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Window Configuration
window-decoration = false
window-padding-x = 0
window-padding-y = 0
background-opacity = 0.95
background-blur-radius = 32
background-opacity-cells = true
background-blur = true

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false
mouse-shift-capture = true
mouse-scroll-multiplier = precision:0.6,discrete:0.6

# Disable annoying copied to clipboard
#app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+key_v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
#keybind = ctrl+t=new_tab
# Disable tab creation and let Herdr own tab/workspace navigation:
# unbind Ghostty's tab keys so they pass through to Herdr.
keybind = ctrl+shift+t=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Catppuccin Mocha UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #313244

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor,ssh-env,ssh-terminfo
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = false

# Theme
theme = Catppuccin Mocha
