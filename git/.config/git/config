[user]
	name = Jesper Liljegren
	email = jesper.liljegren@gmail.com

[init]
	defaultBranch = main

[core]
	editor = nvim
	autocrlf = input
	# Exclude file for global gitignore patterns
	excludesfile = ~/.config/git/ignore

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[submodule]
	recurse = true

[color]
	ui = auto

[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	amend = commit --amend --no-edit

[diff]
	colorMoved = zebra
	tool = bc

[merge]
	tool = bc

[mergetool "nvim"]
	# Layout: Top row [Local | Base | Remote], Bottom row [Merged Result]
	cmd = nvim -d -c \"wincmd J\" \"$LOCAL\" \"$BASE\" \"$REMOTE\" \"$MERGED\"

[mergetool]
	prompt = false
	keepBackup = false


# Conditional includes for work directories
[includeIf "gitdir:~/dev/tengella/"]
	path = ~/.config/git/config-work

[credential]
	helper = /usr/bin/git-credential-manager
	useHttpPath = true
	credentialStore = cache
[include]
	path = ~/.config/delta/delta.gitconfig

[color "diff"]
	old = red
	new = green
