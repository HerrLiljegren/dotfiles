#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)"
ALIASES_FILE="$ROOT/shell/git-aliases.sh"
GUIDE_FILE="$ROOT/shell/git-alias-guide.tsv"

usage() {
  printf 'usage: git-aliases [--plain] [--all | <alias> | <category>]\n' >&2
}

plain=0
show_all=0
query=''

while (($#)); do
  case "$1" in
    --plain)
      plain=1
      ;;
    --all)
      [[ -z "$query" ]] || {
        usage
        exit 2
      }
      show_all=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      usage
      exit 2
      ;;
    *)
      [[ -z "$query" && "$show_all" == 0 ]] || {
        usage
        exit 2
      }
      query=$1
      ;;
  esac
  shift
done

if [[ -t 1 && "$plain" == 0 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
  bold=$'\033[1m'
  cyan=$'\033[36m'
  yellow=$'\033[33m'
  dim=$'\033[2m'
  reset=$'\033[0m'
else
  bold=''
  cyan=''
  yellow=''
  dim=''
  reset=''
fi

shopt -s expand_aliases
source "$ALIASES_FILE"

alias_command() {
  local name=$1
  local definition=''
  local command=''

  definition="$(alias "$name")"
  command=${definition#*=}
  command=${command#\'}
  command=${command%\'}
  printf '%s' "$command"
}

print_detail() {
  local category=$1
  local name=$2
  local what=$3
  local when=$4
  local why=$5
  local example=$6
  local command=''

  command="$(alias_command "$name")"
  printf '%s%s%s  %s%s%s\n' "$bold" "$name" "$reset" "$dim" "$command" "$reset"
  printf '  %sWhat:%s %s\n' "$cyan" "$reset" "$what"
  printf '  %sWhen:%s %s\n' "$cyan" "$reset" "$when"
  printf '  %sWhy:%s  %s\n' "$cyan" "$reset" "$why"
  printf '  %sTry:%s  %s\n' "$yellow" "$reset" "$example"
  printf '  %sCategory:%s %s\n\n' "$dim" "$reset" "$category"
}

printf '%sGit alias guide%s\n' "$bold" "$reset"

if [[ "$show_all" == 1 || -n "$query" ]]; then
  found=0
  while IFS=$'\t' read -r category name what when why example; do
    [[ -n "$category" && ${category:0:1} != '#' ]] || continue
    if [[ "$show_all" == 1 || "$query" == "$name" || "$query" == "$category" ]]; then
      print_detail "$category" "$name" "$what" "$when" "$why" "$example"
      found=1
    fi
  done <"$GUIDE_FILE"

  if [[ "$found" == 0 ]]; then
    printf 'No alias or category named %q.\n' "$query" >&2
    exit 1
  fi
  exit 0
fi

printf '%sUse git-aliases <alias|category> for when, why, and an example.%s\n\n' "$dim" "$reset"
current_category=''
while IFS=$'\t' read -r category name what _when _why _example; do
  [[ -n "$category" && ${category:0:1} != '#' ]] || continue
  if [[ "$category" != "$current_category" ]]; then
    [[ -z "$current_category" ]] || printf '\n'
    printf '%s%s%s\n' "$bold" "${category^^}" "$reset"
    current_category=$category
  fi
  printf '  %s%-6s%s %s\n' "$cyan" "$name" "$reset" "$what"
done <"$GUIDE_FILE"
